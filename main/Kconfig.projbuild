menu "BookBook"
    choice BOOKBOOK_BOARD
        prompt "Target board"
        default BOOKBOOK_BOARD_WAVESHARE_AUDIO
        help
            Waveshare board is the real target. XIAO is a temporary development stand-in
            (user LED on GPIO21 as a single on/off light, BOOT button on GPIO0 as Key1).

        config BOOKBOOK_BOARD_WAVESHARE_AUDIO
            bool "Waveshare ESP32-S3-AUDIO-Board"
        config BOOKBOOK_BOARD_XIAO_ESP32S3
            bool "Seeed XIAO ESP32-S3 (temporary dev stand-in)"
    endchoice

    config BOOKBOOK_XIAO_LED_COUNT
        int "Number of WS2812 LEDs on GPIO2 (XIAO stand-in only)"
        default 12
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3

    config BOOKBOOK_I2S_BCLK
        int "MAX98357A BCLK GPIO (XIAO stand-in)"
        default 7
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_I2S_LRC
        int "MAX98357A LRC/WS GPIO (XIAO stand-in)"
        default 44
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_I2S_DIN
        int "MAX98357A DIN GPIO (XIAO stand-in)"
        default 8
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_I2S_SD_MODE
        int "MAX98357A SD_MODE GPIO (XIAO stand-in)"
        default 9
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_MIC_CLK
        int "PDM microphone CLK GPIO (XIAO stand-in)"
        default 1
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_MIC_DAT
        int "PDM microphone DAT GPIO (XIAO stand-in)"
        default 3
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_MIC_RIGHT_SLOT
        bool "Microphone SEL is tied to 3V3 (right slot); off = SEL tied to GND (left slot)"
        default n
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
    config BOOKBOOK_MIC_GAIN
        int "Microphone software gain (multiplier)"
        range 1 32
        default 4

    config BOOKBOOK_TOUCH_ENABLED
        bool "Use the capacitive touch pad as the button (off: the BOOT button is the button)"
        default y
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
        help
            Turn this off to run without the touch sensor at all (for example to rule it out while
            debugging); the BOOT button (GPIO0) then becomes the button.
    config BOOKBOOK_TOUCH_PIN
        int "Capacitive touch pad GPIO, used as the button (XIAO stand-in)"
        default 6
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
        help
            Same pad as PhilbotSays: GPIO6 (XIAO D5). Must be a touch-capable pin (GPIO1-14 on the
            ESP32-S3; the number equals the touch channel).
    config BOOKBOOK_TOUCH_ALSO_BOOT_BUTTON
        bool "Also treat the BOOT button (GPIO0) as the button (bench fallback)"
        default n
        depends on BOOKBOOK_BOARD_XIAO_ESP32S3
        help
            ORs the BOOT button in with the touch pad, like PhilbotSays' dev button. Off by default:
            the touch pad is the button. Never hold BOOT while powering up or resetting.

    config BOOKBOOK_ANTHROPIC_KEY
        string "Anthropic API key (baked in)"
        default ""
    config BOOKBOOK_MEMORY_URL
        string "Memory storage container SAS URL (baked in)"
        default ""
    config BOOKBOOK_PRACTICE_MODE
        bool "Practice mode: pretend to add and remove books, change nothing on the real account"
        default y
    config BOOKBOOK_VA_USER
        string "Library login: email or VA id (default; editable on the setup page)"
        default ""
    config BOOKBOOK_VA_PASSWORD
        string "Library password (default; editable on the setup page)"
        default ""

    config BOOKBOOK_CLAUDE_MODEL
        string "Claude model id"
        default "claude-sonnet-5"

    config BOOKBOOK_SPEAKER_VOLUME
        int "Software volume, percent of full scale"
        range 1 100
        default 80

    config BOOKBOOK_ADMIN_PASSWORD
        string "Factory default password for the setup page (user name: admin)"
        default "bookbook"
        help
            Used until a different password is saved on the setup page. Override it in the git-ignored
            secrets/sdkconfig.secrets rather than committing a real value.

    config BOOKBOOK_SETUP_AP_PASSWORD
        string "Password of the BookBook-XXXX setup Wi-Fi network (8-63 characters)"
        default "bookbook1"
        help
            Anyone who knows this can join the setup network. Override it in the git-ignored
            secrets/sdkconfig.secrets rather than committing a real value.

    config BOOKBOOK_WIFI_SSID
        string "Wi-Fi SSID (development only)"
        default ""
    config BOOKBOOK_WIFI_PASSWORD
        string "Wi-Fi password (development only)"
        default ""
    config BOOKBOOK_AZURE_SPEECH_KEY
        string "Azure Speech key (development only)"
        default ""
    config BOOKBOOK_AZURE_SPEECH_REGION
        string "Azure Speech region (development only)"
        default "eastus"
endmenu
